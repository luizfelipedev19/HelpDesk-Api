# Copie para .env e ajuste. Com Docker Compose, DB_HOST deve ser "db".
DB_HOST=localhost
DB_PORT=5432
DB_USUARIO=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=helpdesk

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Só usadas por `npm run seed` (cria empresa + admin inicial, idempotente)
SEED_COMPANY_NAME=Minha Empresa
SEED_COMPANY_CNPJ=11.222.333/0001-81
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=troque-esta-senha
